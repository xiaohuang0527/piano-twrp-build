# Android fstab file (recovery)
# Derived from stock vendor/etc/fstab.qcom of Xiaomi Pad 8 Pro (piano)
# Note: recovery needs no first_stage_mount; TWRP handles logical/dm devices.

#<src>                                        <mnt_point>         <type>   <mnt_flags and options>                                        <fs_mgr_flags>
system                                         /system             ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta_system,logical
system                                         /system             erofs    ro                                                           wait,slotselect,avb=vbmeta_system,logical
system_ext                                     /system_ext         ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta_system,logical
system_ext                                     /system_ext         erofs    ro                                                           wait,slotselect,avb=vbmeta_system,logical
product                                        /product            ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta_system,logical
product                                        /product            erofs    ro                                                           wait,slotselect,avb=vbmeta_system,logical
vendor                                         /vendor             ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta,logical
vendor                                         /vendor             erofs    ro                                                           wait,slotselect,avb=vbmeta,logical
vendor_dlkm                                    /vendor_dlkm        ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta,logical
vendor_dlkm                                    /vendor_dlkm        erofs    ro                                                           wait,slotselect,avb=vbmeta,logical
system_dlkm                                    /system_dlkm        ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta,logical
system_dlkm                                    /system_dlkm        erofs    ro                                                           wait,slotselect,avb=vbmeta,logical
odm                                            /odm                ext4     ro,barrier=1,discard                                         wait,slotselect,avb=vbmeta,logical
odm                                            /odm                erofs    ro                                                           wait,slotselect,avb=vbmeta,logical

# Metadata partition (FBE key storage)
/dev/block/by-name/metadata                    /metadata           f2fs     noatime,nosuid,nodev,discard                                 wait,check,formattable

# Userdata (FBE v2, wrapped key, inlinecrypt)
/dev/block/bootdevice/by-name/userdata         /data               f2fs     noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt,gc_merge,compress_mode=user,compress_cache,atgc,age_extent_cache   latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs

/dev/block/bootdevice/by-name/persist          /persist            ext4     noatime,nosuid,nodev,barrier=1                             wait,check

# Firmware / misc partitions
/dev/block/by-name/boot                        /boot               emmc     defaults                                                   slotselect
/dev/block/by-name/init_boot                   /init_boot          emmc     defaults                                                   slotselect
/dev/block/by-name/vendor_boot                 /vendor_boot        emmc     defaults                                                   slotselect
/dev/block/by-name/dtbo                        /dtbo               emmc     defaults                                                   slotselect
/dev/block/by-name/vbmeta                      /vbmeta             emmc     defaults                                                   slotselect
/dev/block/by-name/vbmeta_system               /vbmeta_system      emmc     defaults                                                   slotselect
/dev/block/by-name/misc                        /misc               emmc     defaults                                                   defaults
/dev/block/bootdevice/by-name/rescue           /mnt/rescue         ext4     noatime,nosuid,nodev,barrier=1                             wait,check,nofail

# OTG storage
/devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*   /storage/usbotg   vfat    nosuid,nodev                                          wait,voldmanaged=usbotg:auto
